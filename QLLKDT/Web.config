<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="QLCHLK" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QLCHLK;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web><globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/><compilation debug="true" targetFramework="4.8"/><httpRuntime targetFramework="4.8" maxRequestLength="4096"/><httpCookies httpOnlyCookies="true" sameSite="Lax"/><sessionState timeout="30"/><pages controlRenderingCompatibilityVersion="4.0"/></system.web>
  <system.webServer><defaultDocument enabled="true"><files><clear/><add value="Default.aspx"/></files></defaultDocument></system.webServer>
</configuration>
