<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Default.aspx.cs" Inherits="QLLKDT._Default" MasterPageFile="~/Site.Master" %>
<asp:Content ID="PageContent" ContentPlaceHolderID="MainContent" runat="server">
<form id="form1" runat="server"><div class="title"><div><h1>Quản lý linh kiện điện tử</h1><p>Theo dõi sản phẩm và hoạt động bán hàng của cửa hàng</p></div><a class="primary" href="QuanLy.aspx?m=sanpham&amp;action=add">＋ &nbsp; Thêm sản phẩm</a></div>

<asp:Panel ID="pnlError" CssClass="error" Visible="false" runat="server"><b>Không thể tải dữ liệu SQL Server.</b> Kiểm tra tên server trong Web.config và database QLCHLK. <asp:Literal ID="litError" runat="server"/></asp:Panel>
<div class="stats"><div class="stat"><i>⬡</i><section>Sản phẩm đang kinh doanh<strong><asp:Literal ID="litProducts" runat="server"/></strong></section></div><div class="stat"><i>🛒</i><section>Hóa đơn hôm nay<strong><asp:Literal ID="litOrders" runat="server"/></strong></section></div><div class="stat"><i class="green">▤</i><section>Giá trị hóa đơn hôm nay<strong><asp:Literal ID="litRevenue" runat="server"/></strong></section></div><div class="stat"><i class="purple">♧</i><section>Khách hàng<strong><asp:Literal ID="litCustomers" runat="server"/></strong></section></div></div>
<section class="panel"><h2>Danh sách sản phẩm</h2><p><a href="QuanLy.aspx?m=sanpham">Quản lý danh sách / xóa sản phẩm</a></p><div class="filters"><asp:TextBox ID="txtSearch" runat="server" placeholder="Tìm mã hoặc tên sản phẩm..."/><asp:DropDownList ID="ddlCategory" runat="server"/><asp:DropDownList ID="ddlBrand" runat="server"/><asp:Button ID="btnFilter" runat="server" Text="Tìm kiếm" CssClass="filterbtn" OnClick="Filter_Click"/></div><div class="chips"><asp:Repeater ID="rptCategories" runat="server"><ItemTemplate><a href='<%# CategoryUrl(Eval("MaLoai")) %>'><%#: Eval("TenLoai") %></a></ItemTemplate></asp:Repeater></div>
<div class="grid"><asp:Repeater ID="rptProducts" runat="server"><ItemTemplate><article class="card"><div class="productimage"><%# ProductPhoto(Eval("MaLK"), Eval("HinhAnh"), Eval("TenLK"), Eval("TenLoai")) %><a class="edit" title="Sửa sản phẩm" href='<%# "QuanLy.aspx?m=sanpham&amp;action=edit&amp;id=" + Server.UrlEncode(Convert.ToString(Eval("MaLK"))) %>'>✎</a></div><h3><%#: Eval("TenLK") %></h3><p>Mã: <%#: Eval("MaLK") %></p><div class="cardbottom"><strong><%# Money(Eval("GiaBan")) %></strong><span class="badge"><%#: Eval("TrangThai") %></span></div></article></ItemTemplate></asp:Repeater></div><asp:Panel runat="server" ID="pnlEmpty" CssClass="empty" Visible="false">Không có sản phẩm phù hợp.</asp:Panel><div class="footer"><asp:Literal ID="litCount" runat="server"/><div class="pages"><asp:LinkButton ID="btnPrev" runat="server" OnClick="Prev_Click">‹</asp:LinkButton><asp:Literal ID="litPage" runat="server"/><asp:LinkButton ID="btnNext" runat="server" OnClick="Next_Click">›</asp:LinkButton></div></div></section></form>
</asp:Content>
