<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="QLLKDT.Login" %>
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Đăng nhập · Cửa hàng linh kiện</title><link href="Content/login.css" rel="stylesheet"/></head><body><main class="login-shell"><section class="intro"><div class="brand"><span class="logo">▦</span><span>LINH KIỆN <b>STUDIO</b></span></div><div class="intro-main"><span class="eyebrow">KHÔNG GIAN LÀM VIỆC CỦA BẠN</span><h1>Chào ngày mới,<br/><span>làm việc thật tốt.</span></h1><p>Mọi thông tin bạn cần cho một ngày làm việc, gọn gàng trong một không gian.</p><div class="feature"><span>▦</span><div><b>Quản lý linh kiện</b><small>Tìm kiếm và cập nhật nhanh chóng</small></div></div><div class="feature"><span>◇</span><div><b>Bán hàng thuận tiện</b><small>Theo dõi hóa đơn và khách hàng</small></div></div></div><p class="caption">Được thiết kế cho những ngày làm việc dễ dàng hơn ✦</p><div class="orb one"></div><div class="orb two"></div></section><section class="login-side"><div class="login-card"><span class="mini">XIN CHÀO 👋</span><h2>Đăng nhập</h2><p class="description">Nhập thông tin tài khoản để tiếp tục làm việc.</p><div class="error" <%= String.IsNullOrEmpty(Message) ? "hidden" : "" %>><%= Message %></div><form method="post"><input type="hidden" name="csrf" value="<%= Token %>"/><label for="username">Tên đăng nhập</label><input id="username" name="username" maxlength="50" required autocomplete="username" placeholder="Nhập tên đăng nhập"/><label for="password">Mật khẩu</label><div class="password"><input id="password" name="password" type="password" maxlength="100" required autocomplete="current-password" placeholder="Nhập mật khẩu"/><button type="button" id="toggle" aria-label="Hiện mật khẩu">Hiện</button></div><button class="submit" type="submit">Đăng nhập <span>→</span></button></form><div class="help">Cần hỗ trợ? Hãy liên hệ quản trị viên của cửa hàng.</div></div><p class="footer">Cửa hàng linh kiện điện tử · Không gian làm việc</p></section></main><script>document.getElementById('toggle').onclick=function(){var p=document.getElementById('password');var show=p.type==='password';p.type=show?'text':'password';this.textContent=show?'Ẩn':'Hiện';this.setAttribute('aria-label',show?'Ẩn mật khẩu':'Hiện mật khẩu')};</script></body></html>
