<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="QLLKDT.SiteMaster" %>
<!doctype html><html lang="vi"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Quản lý linh kiện điện tử</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="Content/site.css" rel="stylesheet"/><link href="Content/manage.css" rel="stylesheet"/><link href="Content/nangcap.css" rel="stylesheet"/><asp:ContentPlaceHolder ID="HeadContent" runat="server" /></head><body>
<aside class="sidebar"><div class="brand"><span class="chip">▦</span><div><strong>QUẢN LÝ CỬA HÀNG</strong><small>Linh kiện điện tử</small></div></div><nav><%= NavHtml %></nav><form method="post" action="Logout.aspx" class="logout"><input type="hidden" name="csrf" value="<%= TokenHtml %>"/><button type="submit" class="logoutbtn">↪ &nbsp; Đăng xuất</button></form></aside>
<div class="main"><header><div>⌂ &nbsp; Cửa hàng</div><div class="user">◉ &nbsp; <%= RoleHtml %></div></header><main><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main></div></body></html>
